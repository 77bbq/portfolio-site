{
  "name": "robotics-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "media:image": "node scripts/prepare-media.mjs image",
    "media:poster": "node scripts/prepare-media.mjs poster",
    "media:video": "node scripts/prepare-media.mjs video",
    "test": "vitest --exclude tests/*-output.test.ts --exclude tests/built-site-integrity.test.ts",
    "test:unit": "vitest run --exclude tests/*-output.test.ts --exclude tests/built-site-integrity.test.ts"
  },
  "dependencies": {
    "astro": "^7.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^24.19.2",
    "cheerio": "^1.2.0",
    "ffmpeg-static": "^5.3.0",
    "gray-matter": "^4.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
