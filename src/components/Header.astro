---
import { siteIdentity } from "../data/site";
import { withBasePath } from "../lib/paths";

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBasePath("/", base)} aria-label={`${siteIdentity.title}首页`}>
      <span class="brand-copy">
        <strong>{siteIdentity.name || siteIdentity.title}</strong>
        <small>项目与实践</small>
      </span>
    </a>

    <nav aria-label="主导航">
      <a href={withBasePath("/#graduate-projects", base)}>研究生项目</a>
      <a href={withBasePath("/#undergraduate-projects", base)}>本科生项目</a>
    </nav>
  </div>
</header>
