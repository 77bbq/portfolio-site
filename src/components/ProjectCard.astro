---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";

import { withBasePath } from "../lib/paths";
import { STAGE_LABELS, STATUS_LABELS, hasUsableCover } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const projectHref = withBasePath(`/projects/${data.slug}/`, import.meta.env.BASE_URL);
const hasCover = hasUsableCover(data);
const tech = data.tech.filter((item) => item.trim());
const cover = data.cover;
const responsiveWidths = cover
  ? [...new Set([480, 800, 1200].filter((width) => width <= cover.width).concat(cover.width))].sort(
      (left, right) => left - right,
    )
  : [];
const isPriority = data.stage === "graduate" && data.order === 10;
---

<article
  class:list={["project-card", { "project-card--ongoing": data.status === "ongoing" }]}
  data-project-card
>
  <a href={projectHref} aria-label={`查看${data.title}项目`}>
    <div
      class:list={["project-card__media", `project-card__media--${data.coverFit ?? "cover"}`]}
      style={data.coverPosition ? `--cover-position: ${data.coverPosition}` : undefined}
    >
      {
        hasCover && cover ? (
          <Picture
            src={cover}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={responsiveWidths}
            sizes="(min-width: 1080px) 31vw, (min-width: 680px) 48vw, 100vw"
            alt={data.coverAlt}
            loading={isPriority ? "eager" : "lazy"}
            fetchpriority={isPriority ? "high" : "auto"}
          />
        ) : (
          <svg
            viewBox="0 0 640 400"
            role="img"
            aria-label={`${data.title}暂无封面`}
            data-cover-fallback
          >
            <rect width="640" height="400" fill="currentColor" opacity="0.08" />
            <path
              d="M204 265V135l116-67 116 67v130l-116 67-116-67Zm116-38 50-29v-58l-50-29-50 29v58l50 29Z"
              fill="none"
              stroke="currentColor"
              stroke-width="12"
            />
            <circle cx="320" cy="169" r="13" fill="currentColor" />
          </svg>
        )
      }
      <span class="project-card__index" aria-hidden="true">
        {String(data.order).padStart(2, "0")}
      </span>
    </div>

    <div class="project-card__body">
      <div class="project-card__meta">
        <span>{STAGE_LABELS[data.stage]}</span>
        <span class:list={["status", `status--${data.status}`]}>{STATUS_LABELS[data.status]}</span>
      </div>
      <h3>{data.title}</h3>
      {data.summary && <p data-project-summary>{data.summary}</p>}
      {
        tech.length > 0 && (
          <ul data-project-tech aria-label="项目技术">
            {tech.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      <span class="project-card__cta">
        查看项目 <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>
