---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";

import { withBasePath } from "../lib/paths";
import { STAGE_LABELS, STATUS_LABELS, hasUsableCover } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const projectHref = withBasePath(`/projects/${data.slug}/`, import.meta.env.BASE_URL);
const hasCover = hasUsableCover(data);
const tech = data.tech.filter((item) => item.trim());
const outcomes = data.metrics.filter((item) => item.trim());
const cover = data.cover;
const responsiveWidths = cover
  ? [...new Set([480, 800, 1200].filter((width) => width <= cover.width).concat(cover.width))].sort(
      (left, right) => left - right,
    )
  : [];
const isPriority = data.stage === "graduate" && data.order === 10;
---

<article
  class:list={["project-card", { "project-card--ongoing": data.status === "ongoing" }]}
  data-project-card
>
  <a href={projectHref} aria-label={`查看${data.title}项目`}>
    <div
      class:list={["project-card__media", `project-card__media--${data.coverFit ?? "cover"}`]}
      style={data.coverPosition ? `--cover-position: ${data.coverPosition}` : undefined}
    >
      {
        hasCover && cover ? (
          <Picture
            src={cover}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={responsiveWidths}
            sizes={data.stage === "graduate"
              ? "(min-width: 1200px) 388px, (min-width: 760px) 36vw, calc(100vw - 40px)"
              : "(min-width: 1200px) 520px, (min-width: 760px) 46vw, calc(100vw - 40px)"}
            alt={data.coverAlt}
            loading={isPriority ? "eager" : "lazy"}
            fetchpriority={isPriority ? "high" : "auto"}
          />
        ) : (
          <div
            class="project-cover-note"
            role="img"
            aria-label={`${data.title}项目记录，影像资料待补充`}
            data-cover-fallback
          >
            <span>{data.stage === "graduate" ? "研究笔记" : "项目笔记"}</span>
            <strong>{data.title}</strong>
            <span class="project-cover-note__caption">影像资料待补充</span>
          </div>
        )
      }
    </div>

    <div class="project-card__body">
      <div class="project-card__meta">
        <span class="project-card__index sr-only" aria-hidden="true">
          {String(data.order).padStart(2, "0")}
        </span>
        <span class="sr-only">{STAGE_LABELS[data.stage]}</span>
        <span class:list={["status", `status--${data.status}`]}>{STATUS_LABELS[data.status]}</span>
      </div>
      <h3>{data.title}</h3>
      {data.summary && <p data-project-summary>{data.summary}</p>}
      {
        outcomes.length > 0 && (
          <ul class="project-outcomes" data-project-outcomes aria-label="项目成果">
            {outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
        )
      }
      {
        tech.length > 0 && (
          <ul data-project-tech aria-label="项目技术">
            {tech.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      <span class="project-card__cta">
        项目详情 <span aria-hidden="true">↗</span>
      </span>
    </div>
  </a>
</article>
