---
interface Props {
  summary?: string;
  roles: string[];
  tech: string[];
  metrics: string[];
}

const { summary = "", roles, tech, metrics } = Astro.props;
const visibleRoles = roles.filter((item) => item.trim());
const visibleTech = tech.filter((item) => item.trim());
const visibleMetrics = metrics.filter((item) => item.trim());
const hasFacts = visibleRoles.length > 0 || visibleTech.length > 0 || visibleMetrics.length > 0;
---

{
  summary && (
    <section class="project-summary" data-project-summary aria-labelledby="project-summary-title">
      <p class="fact-label" id="project-summary-title">
        项目摘要
      </p>
      <p>{summary}</p>
    </section>
  )
}

{
  hasFacts && (
    <div class="facts-grid">
      {visibleRoles.length > 0 && (
        <section data-project-roles>
          <h2>我的职责</h2>
          <ul>
            {visibleRoles.map((role) => (
              <li>{role}</li>
            ))}
          </ul>
        </section>
      )}
      {visibleTech.length > 0 && (
        <section data-project-tech>
          <h2>核心技术</h2>
          <ul class="tag-list">
            {visibleTech.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}
      {visibleMetrics.length > 0 && (
        <section data-project-metrics>
          <h2>项目成果</h2>
          <ul>
            {visibleMetrics.map((metric) => (
              <li>{metric}</li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )
}

<style>
  .project-summary {
    display: grid;
    padding: clamp(20px, 3vw, 28px);
    gap: 8px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 0;
    background: var(--paper-raised);
  }

  .project-summary p {
    margin: 0;
  }

  .project-summary p:last-child {
    max-width: 52rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.75;
  }

  .fact-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .facts-grid {
    display: grid;
    gap: 24px;
  }

  .facts-grid section {
    min-width: 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
  }

  .facts-grid h2 {
    margin: 0 0 12px;
    color: var(--quiet);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .facts-grid ul {
    padding: 0;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    list-style: none;
  }

  .facts-grid li + li {
    margin-top: 6px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .tag-list li {
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 0;
  }

  .tag-list li + li::before {
    color: var(--line-strong);
    content: " / ";
  }

  @media (min-width: 760px) {
    .facts-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
