---
import type { CollectionEntry } from "astro:content";

import ConfiguredLink from "../components/ConfiguredLink.astro";
import PlaceholderNotice from "../components/PlaceholderNotice.astro";
import ProjectFacts from "../components/ProjectFacts.astro";
import ProjectMedia from "../components/ProjectMedia.astro";
import BaseLayout from "./BaseLayout.astro";
import { stageBackHref, STAGE_LABELS, STATUS_LABELS } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  showBody: boolean;
}

const { project, showBody } = Astro.props;
const { data } = project;
const backHref = stageBackHref(data.stage, import.meta.env.BASE_URL);
const hasLinks = Object.values(data.links).some((value) => value.trim());
---

<BaseLayout title={data.title} description={data.summary || `${data.title}项目详情`}>
  <article class="project-detail">
    <header class="detail-hero">
      <div class="shell detail-hero__inner">
        <a class="back-link" href={backHref}>
          <span aria-hidden="true">←</span>
          返回{STAGE_LABELS[data.stage]}
        </a>
        <div class="detail-identity">
          <p class="eyebrow">{data.stage === "graduate" ? "研究生项目档案" : "本科生项目档案"}</p>
          <h1>{data.title}</h1>
          <div class="detail-meta" aria-label="项目信息">
            <span>{STAGE_LABELS[data.stage]}</span>
            <span class:list={["status", `status--${data.status}`]}>{STATUS_LABELS[data.status]}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="shell detail-content">
      <ProjectFacts
        summary={data.summary}
        roles={data.roles}
        tech={data.tech}
        metrics={data.metrics}
      />

      <ProjectMedia
        media={data.media}
        projectTitle={data.title}
        cover={data.cover}
        coverAlt={data.coverAlt}
      />

      {
        hasLinks && (
          <nav class="project-links" data-project-links aria-label="项目相关链接">
            <ConfiguredLink href={data.links.repository} label="项目仓库" />
            <ConfiguredLink href={data.links.demo} label="演示链接" />
            <ConfiguredLink href={data.links.document} label="项目文档" />
          </nav>
        )
      }

      {
        showBody ? (
          <div class="project-body" data-project-body>
            <slot />
          </div>
        ) : (
          <PlaceholderNotice />
        )
      }

      <a class="back-link back-link--bottom" href={backHref}>
        <span aria-hidden="true">←</span>
        返回{STAGE_LABELS[data.stage]}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .detail-hero {
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper-deep);
  }

  .detail-hero__inner {
    padding-block: 28px 44px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 8px;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .detail-identity {
    margin-top: 28px;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .detail-meta {
    display: flex;
    align-items: center;
    margin-top: 26px;
    gap: 18px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .detail-meta .status {
    color: var(--quiet);
  }

  .detail-meta .status--ongoing {
    color: var(--accent);
  }

  .detail-content {
    display: grid;
    padding-block: clamp(32px, 5vw, 58px);
    gap: clamp(28px, 4vw, 42px);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .project-links :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0 3px;
    gap: 6px;
    color: var(--accent);
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.84rem;
  }

  .project-links :global(a:hover) {
    border-color: var(--accent);
  }

  .project-body {
    max-width: 760px;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.9;
  }

  .project-body :global(h2) {
    margin: 2.4em 0 0.7em;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .project-body :global(h2:first-child) {
    margin-top: 0;
  }

  .project-body :global(p),
  .project-body :global(li) {
    max-width: 72ch;
  }

  .back-link--bottom {
    justify-self: start;
    padding-right: 12px;
    border-top: 1px solid var(--line);
  }
</style>
