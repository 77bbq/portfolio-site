---
import ProjectGrid from "../components/ProjectGrid.astro";
import ConfiguredLink from "../components/ConfiguredLink.astro";
import { siteIdentity } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjects, groupProjects, STAGE_LABELS } from "../lib/projects";

const projects = await getProjects();
const groupedProjects = groupProjects(projects);
---

<BaseLayout>
  <section class="hero" aria-labelledby="portfolio-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">机器人与嵌入式 · 个人作品集</p>
        <h1 id="portfolio-title">{siteIdentity.name || siteIdentity.title}</h1>
        <p class="hero-direction">{siteIdentity.direction}</p>
      </div>

      <div class="hero-about">
        <p class="hero-note">在做的事，和做过的事。</p>
        {siteIdentity.intro && <p class="hero-intro">{siteIdentity.intro}</p>}
        <div class="hero-actions">
          <a class="text-link" href="#graduate-projects">浏览项目 <span aria-hidden="true">↓</span></a>
          <ConfiguredLink href={siteIdentity.resumeUrl} label="个人简历" />
          <ConfiguredLink href={siteIdentity.githubUrl} label="GitHub" />
        </div>
      </div>
    </div>
  </section>

  <div class="shell project-sections">
    <ProjectGrid
      title={STAGE_LABELS.graduate}
      stage="graduate"
      projects={groupedProjects.graduate}
    />
    <ProjectGrid
      title={STAGE_LABELS.undergraduate}
      stage="undergraduate"
      projects={groupedProjects.undergraduate}
    />
  </div>
</BaseLayout>
